# LLM configuration consumed by src/HelloAgentsLLM.py
# DeepSeek via LiteLLM uses the deepseek/ model prefix and DEEPSEEK_API_KEY.
LLM_MODEL_ID=deepseek/deepseek-v4-pro
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional for OpenAI-compatible providers or LiteLLM proxy usage:
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=your-api-base-url
LLM_TIMEOUT=60

# Search backend: duckduckgo (default) or serpapi
SEARCH_API=duckduckgo
# Optional SerpApi key (required if SEARCH_API=serpapi)
# SERPAPI_API_KEY=your-serpapi-key

# Research depth: max number of search loops per run
MAX_WEB_RESEARCH_LOOPS=3
