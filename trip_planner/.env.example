# LLM configuration consumed by src/HelloAgentsLLM.py
# DeepSeek via LiteLLM uses the deepseek/ model prefix and DEEPSEEK_API_KEY.
LLM_MODEL_ID=deepseek/deepseek-v4-pro
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional for OpenAI-compatible providers or LiteLLM proxy usage:
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=your-api-base-url
LLM_TIMEOUT=60

# Optional Amap Web Service API key for POI and weather context
AMAP_API_KEY=your-amap-web-service-key

# Optional: use src/WebSearch.py when map attraction data is unavailable
TRIP_PLANNER_USE_WEB_SEARCH=0
